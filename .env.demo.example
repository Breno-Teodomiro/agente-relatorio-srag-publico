# Modelo do `.env.demo`: banco remoto da demonstração online (carga e conferência, na sua máquina).
# Copie como `.env.demo` e preencha. Este arquivo é só o modelo, com valores falsos; o `.env.demo`
# real NUNCA vai para o Git (o .gitignore já o barra) nem para chat, e-mail ou print.
#
# Senha forte (cada papel com a sua, bem acima de 60 bits de entropia):
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"

# Host DIRETO do banco (sem "-pooler" no nome), como mostra o painel do provedor.
PG_HOST=troque-pelo-host-do-banco.exemplo.com
PG_PORTA=5432
PG_BANCO=troque-pelo-nome-do-banco

# Dono do banco no provedor: só a carga o usa (a tela nunca recebe esta senha).
PG_USUARIO_ADMIN=troque-pelo-dono-do-banco

# TLS: verify-full com o arquivo de certificados do sistema (caminho do Debian/Ubuntu, o mesmo da
# plataforma de publicação). Se este caminho não existir no seu sistema, use o do seu SO; `system`
# não funcionou com a libpq do driver. Sem verificação do servidor: PG_SSLMODE=require.
PG_SSLMODE=verify-full
PG_SSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
PG_CONNECT_TIMEOUT=15

# Senhas: a do dono vem do painel do provedor; as dos papéis da aplicação você gera acima.
PG_SENHA_ADMIN=troque-senha-do-dono
PG_SENHA_AGENTE=troque-senha-do-agente
PG_SENHA_AUDITOR=troque-senha-do-auditor
