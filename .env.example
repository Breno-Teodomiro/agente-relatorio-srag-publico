# Banco (Docker Compose, porta 5435)
# Os testes de integração precisam deste arquivo (cópia como `.env`) e do Postgres no ar (`make subir`).
# Sem eles, `uv run pytest` roda só os testes que não tocam o banco e PULA os demais com aviso;
# `make testes` usa EXIGIR_BANCO=1, e aí banco ausente é erro, não skip.
PG_HOST=localhost
PG_PORTA=5435
PG_SENHA_ADMIN=troque-admin
PG_SENHA_ETL=troque-etl
PG_SENHA_AGENTE=troque-agente
PG_SENHA_AUDITOR=troque-auditor

# Dados: o zip do SRAG fica fora do Git. Nome esperado (fixo em config.py):
#   dados/brutos/INFLUD25_DATASUS-Versao26-06-2025.zip
# Fonte: Open DATASUS (OpenDataSUS), SRAG hospitalizado, arquivo INFLUD25 (ano 2025). Salve com
# esse nome; a versão do arquivo é o sufixo "Versao26-06-2025" (spec, seção de dados). Só
# descomente e mude a linha abaixo se o nome do seu arquivo for outro.
# ARQUIVO_DADOS=dados/brutos/INFLUD25_DATASUS-Versao26-06-2025.zip

# LLM: openrouter (padrão) ou openai. O outro, se tiver chave, vira reserva automática.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Notícias: sem chave da Tavily, usa só o Google News RSS
TAVILY_API_KEY=

# Observabilidade opcional (Langfuse)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Tetos de uma execução (opcional; os padrões abaixo são os do spec)
# MAX_CHAMADAS_FERRAMENTA=12
# MAX_TOKENS_EXECUCAO=60000
# MAX_SEGUNDOS_EXECUCAO=300
# MAX_VOLTAS_COBERTURA=2
# MAX_TENTATIVAS_REDACAO=3
